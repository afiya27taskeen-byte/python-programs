    "def logger(func):\n",
    "    def wrapper(*args, ):\n",
    "        print(\"executing...\")\n",
    "        return func(*args)\n",
    "    return wrapper\n",
    "@logger\n",
    "def say_hi():\n",
    "    print(\"hi\")\n",
    "    say_hi()"
