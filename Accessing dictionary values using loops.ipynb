   "cell_type": "code",
   "source": [
    "student = {\n",
    "    \"Name\": \"Afiya\",\n",
    "    \"Age\": 25,\n",
    "    \"reg no\": 562,\n",
    "    \"Branch\": \"CSE\"\n",
    "}\n",
    "\n",
    "print(\"Keys are:\")\n",
    "for x in student:\n",
    "    print(x)\n",
    "\n",
    "print(\"Values are:\")\n",
    "for x in student.values():\n",
    "    print(x)\n",
    "\n",
    "print(\"Keys and Values are:\")\n",
    "for x, y in student.items():\n",
    "    print(x, y)"
   ],
